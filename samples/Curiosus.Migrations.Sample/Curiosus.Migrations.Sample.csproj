        <OutputType>Exe</OutputType>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <IsPackable>false</IsPackable>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Logging.Console" Version="10.0.0" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\Curiosus.Migrations\Curiosus.Migrations.csproj" />
        <ProjectReference Include="..\..\src\Curiosus.Migrations.PostgreSQL\Curiosus.Migrations.PostgreSQL.csproj" />
        <ProjectReference Include="..\..\src\Curiosus.Migrations.Utils\Curiosus.Migrations.Utils.csproj" />
    </ItemGroup>

    <ItemGroup>
        <None Include="Migrations\*.sql" CopyToOutputDirectory="PreserveNewest" />
    </ItemGroup>

</Project>
