<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFrameworks>net10.0;net9.0</TargetFrameworks>

        <IsPackable>false</IsPackable>

        <RootNamespace>Curiosus.Migrations.IntegrationTests</RootNamespace>

        <Nullable>enable</Nullable>
    </PropertyGroup>

    <!-- EF Core 10 supports net10.0 only. -->
    <ItemGroup Condition="'$(TargetFramework)' == 'net10.0'">
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.12" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    </ItemGroup>
    <ItemGroup Condition="'$(TargetFramework)' == 'net9.0'">
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="9.0.20" />
        <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="9.0.4" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.Extensions.Configuration" Version="10.0.12" />
        <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="10.0.12" />
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="18.10.1" />
        <PackageReference Include="NetEscapades.Configuration.Yaml" Version="3.1.0" />
        <PackageReference Include="Testcontainers" Version="4.15.0" />
        <PackageReference Include="Testcontainers.PostgreSql" Version="4.15.0" />
        <PackageReference Include="xunit.v3.mtp-off" Version="4.0.1" />
        <PackageReference Include="xunit.runner.visualstudio" Version="4.0.0">
          <PrivateAssets>all</PrivateAssets>
          <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\src\Curiosus.Migrations.PostgreSQL\Curiosus.Migrations.PostgreSQL.csproj" />
      <ProjectReference Include="..\..\..\src\Curiosus.Migrations\Curiosus.Migrations.csproj" />
      <ProjectReference Include="..\..\UnitTests\Curiosus.Migrations.PostgreSQL.UnitTests\Curiosus.Migrations.PostgreSQL.UnitTests.csproj" />
    </ItemGroup>

    <ItemGroup>
      <None Update="ScriptMigrations\1.0-correct_script.sql">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="ScriptMigrations\6.0-incorrect_script.sql">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="ScriptMigrations\4.0-script_without_transction.sql">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="DependenciesTests\DependencyScriptMigrations\1.0-correct_script.sql">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="DependenciesTests\DependencyScriptMigrations\4.0-script_with_ok_dependencies.sql">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="DependenciesTests\DependencyScriptMigrations\7.0-script_with_not_ok_dependencies.sql">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="TransactionsTests\TransactionScriptMigrations\1.0-correct_script.sql">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="TransactionsTests\TransactionScriptMigrations\4.0-script_without_transction.sql">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
      <None Update="TransactionsTests\TransactionScriptMigrations\6.0-incorrect_script.sql">
        <CopyToOutputDirectory>Always</CopyToOutputDirectory>
      </None>
    </ItemGroup>

</Project>
